{
  "name": "aws-pricing-generator-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that generates AWS regional pricing files weekly",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret:aws-key": "wrangler secret put AWS_ACCESS_KEY_ID",
    "secret:aws-secret": "wrangler secret put AWS_SECRET_ACCESS_KEY",
    "kv:create": "wrangler kv namespace create PRICING_KV",
    "status": "wrangler tail",
    "build": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "eslint": "^9.39.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.61.1",
    "wrangler": "^3.80.0"
  }
}
