# AWS Pricing API Credentials
#
# These credentials are used by scripts/validate-pricing.mjs to query the AWS Pricing API.
# Note: The AWS Price List Query API is a global service and is hosted in the 'us-east-1' region.
# Your AWS IAM user/role must have permissions to access the pricing service.
#
# Minimum IAM Policy permissions required:
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": [
#         "pricing:GetProducts",
#         "pricing:DescribeServices",
#         "pricing:GetAttributeValues"
#       ],
#       "Resource": "*"
#     }
#   ]
# }

# The AWS Access Key ID for your IAM user
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# The AWS Secret Access Key for your IAM user
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Optional: Session token if you are using temporary AWS credentials
# AWS_SESSION_TOKEN=your_aws_session_token_here
