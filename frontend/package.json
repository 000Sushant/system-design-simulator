{
  "name": "aws-system-design-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "AWS architecture sketchbook and deterministic simulation engine",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production && node scripts/generate-seo-pages.mjs",
    "seo:generate": "node scripts/generate-seo-pages.mjs",
    "test": "ng test",
    "lint": "eslint src",
    "validate:challenges": "node scripts/validate-challenges.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "dependencies": {
    "@angular/animations": "^22.0.5",
    "@angular/common": "^22.0.5",
    "@angular/compiler": "^22.0.5",
    "@angular/core": "^22.0.5",
    "@angular/forms": "^22.0.5",
    "@angular/platform-browser": "^22.0.5",
    "@angular/router": "^22.0.5",
    "@foblex/flow": "^18.6.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "rxjs": "^7.8.1",
    "three": "^0.184.0",
    "tslib": "^2.6.3",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.5",
    "@types/three": "^0.184.1",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.39.4",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.61.1"
  }
}
