{
  "name": "aws-system-design-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "AWS architecture sketchbook and deterministic simulation engine",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production && node scripts/generate-seo-pages.mjs",
    "seo:generate": "node scripts/generate-seo-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "validate:challenges": "node scripts/validate-challenges.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\""
  },
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@foblex/flow": "^18.6.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "rxjs": "^7.8.1",
    "three": "^0.184.0",
    "tslib": "^2.6.3",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "^21.2.18",
    "@types/three": "^0.184.1",
    "angular-eslint": "^21.4.0",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.4",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.4",
    "readdirp": "^5.0.0",
    "sharp": "^0.35.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
