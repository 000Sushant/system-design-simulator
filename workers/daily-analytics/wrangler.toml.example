name = "daily-analytics"
main = "src/index.ts"
compatibility_date = "2024-09-23"
workers_dev = true

# ──────────────────────────────────────────────
# Setup: copy this file to `wrangler.toml` and fill in your own IDs.
#   cp wrangler.toml.example wrangler.toml
# The real wrangler.toml is gitignored so resource IDs stay out of version control.
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# KV Namespace (dedicated to this worker — separate from AWS_PRICING_KV)
# Run: wrangler kv namespace create DAILY_KV
# Then paste the returned `id` below.
# ──────────────────────────────────────────────
[[kv_namespaces]]
binding = "DAILY_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
preview_id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# ──────────────────────────────────────────────
# D1 database (challenge thumbs up/down votes)
# 1. wrangler d1 create challenge-votes (paste the returned database_id below)
# Frontend points at this Worker via environment.votesApiBase.
# ──────────────────────────────────────────────
[[d1_databases]]
binding = "DB"
database_name = "challenge-votes"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# ──────────────────────────────────────────────
# Cron: once a day at 00:15 UTC
# Each run refreshes:
#   - USD→{EUR,GBP,INR,JPY} exchange rates from Frankfurter (ECB daily rates)
#   - GitHub stars/forks/clones + Cloudflare visitor analytics
# Both are cached in KV and served via GET /fx and GET /stats.
# ──────────────────────────────────────────────
[triggers]
crons = ["15 0 * * *"]

# ──────────────────────────────────────────────
# Secrets (set via CLI, never in this file):
#   wrangler secret put GITHUB_TOKEN   # PAT with repo (push) access, for traffic/clones
#   wrangler secret put CF_API_TOKEN   # token with Analytics:Read on the zone
#   wrangler secret put CF_ZONE_TAG    # the zone ID of your deployed domain
# /stats serves zeros until all three are set. /fx needs no secrets.
#
# CORS allowlist for /fx, /stats and /votes (browser origins, comma-separated).
# Defaults to the production site + http://localhost:4200 when unset. Set as a
# plain var, e.g.:
#   [vars]
#   ALLOWED_ORIGINS = "https://srarchitect.qzz.io,http://localhost:4200"
#
# One-time migration of the all-time stats accumulators from the pricing
# worker's KV (run from the repo root; IDs are the respective namespace ids):
#   for k in stats:public stats:clones stats:visitors stats:countries stats:lastRun; do
#     wrangler kv key get "$k" --namespace-id <AWS_PRICING_KV_ID> --remote > tmp.json
#     wrangler kv key put "$k" --path tmp.json --namespace-id <DAILY_KV_ID> --remote
#   done
# ──────────────────────────────────────────────
