name = "aws-pricing-generator"
main = "src/index.ts"
compatibility_date = "2024-09-23"
workers_dev = true

# ──────────────────────────────────────────────
# Setup: copy this file to `wrangler.toml` and fill in your own IDs.
#   cp wrangler.toml.example wrangler.toml
# The real wrangler.toml is gitignored so resource IDs stay out of version control.
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# KV Namespace
# Run: wrangler kv namespace create AWS_PRICING_KV
# Then paste the returned `id` below.
# ──────────────────────────────────────────────
[[kv_namespaces]]
binding = "AWS_PRICING_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
preview_id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# ──────────────────────────────────────────────
# D1 database (challenge thumbs up/down votes)
# 1. wrangler d1 create challenge-votes (paste the returned database_id below)
# Frontend points at this Worker via environment.votesApiBase (dev: http://127.0.0.1:8787).
# ──────────────────────────────────────────────
[[d1_databases]]
binding = "DB"
database_name = "challenge-votes"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# ──────────────────────────────────────────────
# Workflow: the weekly pricing rebuild (region × phase steps, engine-managed
# retries). See src/workflow.ts.
# ──────────────────────────────────────────────
[[workflows]]
name = "pricing-rebuild"
binding = "PRICING_WORKFLOW"
class_name = "PricingWorkflow"

# ──────────────────────────────────────────────
# Crons (the handler branches on which schedule fired):
#   0 3 * * 7 — weekly full rebuild of all regions (Sunday; CF cron wants 7, not 0)
#   0 4 * * * — daily repair of the failure queue (no-op when empty)
# ──────────────────────────────────────────────
[triggers]
crons = ["0 3 * * 7", "0 4 * * *"]

# ──────────────────────────────────────────────
# Secrets (set via CLI, never in this file):
#   wrangler secret put AWS_ACCESS_KEY_ID
#   wrangler secret put AWS_SECRET_ACCESS_KEY
#
# Admin auth — required to use POST /trigger, /reset, /start. When unset, those
# endpoints return 503 (disabled). Generate a strong random value, e.g.:
#   openssl rand -hex 32 | wrangler secret put ADMIN_TOKEN
# Then call: curl -X POST -H "Authorization: Bearer <token>" .../trigger
#
# CORS allowlist for /votes (browser origins, comma-separated).
# Defaults to the production site + http://localhost:4200 when unset. Set as a
# plain var (not a secret), e.g. in a [vars] block:
#   ALLOWED_ORIGINS = "https://srarchitect.qzz.io,http://localhost:4200"
#
# NOTE: project analytics (/stats) and FX rates (/fx) moved to the
# `daily-analytics` worker (see ../daily-analytics), which owns
# GITHUB_TOKEN / CF_API_TOKEN / CF_ZONE_TAG now.
# ──────────────────────────────────────────────
